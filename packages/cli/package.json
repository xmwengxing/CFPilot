{
  "name": "cfpilot",
  "version": "0.12.7",
  "description": "CFPilot —— Cloudflare Pages 代理部署与优选工具（交互菜单 + 子命令）",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "cfpilot": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/sync-asset.mjs && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/sync-version.mjs packages/cli && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
