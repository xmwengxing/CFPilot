<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 面板本身在本地，但优选 / 部署都要出网（Cloudflare API、优选 IP 的 TLS 握手） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      前台服务：本地服务要常驻。

      ⚠️ 为什么必须前台服务：安卓会随时回收后台进程，
      服务一停，界面就打不开了。而且「定时优选」在手机上不可靠
      （安卓不允许后台长期跑定时任务）—— 所以那部分交给容器形态做。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CFPilot"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务：type="dataSync" 表示它是「数据同步」类的常驻服务。

          ⚠️ 之所以用 dataSync 而不是 specialUse：
          我们的服务就是「持续与 Cloudflare 同步数据」（部署状态、优选结果、
          外部数据源），归到 dataSync 最贴切，也最容易过审。
        -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
