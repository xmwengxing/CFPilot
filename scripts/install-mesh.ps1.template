# CFPilot +mesh Windows 安装脚本（随安装包分发，用户双击运行）。
#
# 关键点：wintun.dll 不随包分发（ADR-0002），安装时**提权**下载到 exe 同级目录。
# 这样服务首次启动时 DLL 已就位，不依赖运行时网络。
$ErrorActionPreference = 'Stop'

$exeName = 'EXE_NAME_PLACEHOLDER'
$installDir = Join-Path $env:LOCALAPPDATA 'CFPilot-Mesh'
New-Item -ItemType Directory -Force -Path $installDir | Out-Null

# 复制主程序
$src = Join-Path $PSScriptRoot $exeName
Copy-Item -Path $src -Destination (Join-Path $installDir $exeName) -Force

# 提权下载 wintun.dll（calling cfpilot's built-in fetch command）
$exePath = Join-Path $installDir $exeName
Write-Host '正在下载并校验 wintun.dll（官方源 + SHA256 校验）…'
& $exePath --fetch-wintun $installDir
if ($LASTEXITCODE -ne 0) {
    Write-Error 'wintun.dll 下载/校验失败，安装中止。请检查网络后重试，或从 wintun.net 手动放置。'
    exit 1
}

# 创建开始菜单快捷方式
$startup = Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs'
$lnk = Join-Path $startup 'CFPilot Mesh.lnk'
$ws = New-Object -ComObject WScript.Shell
$sc = $ws.CreateShortcut($lnk)
$sc.TargetPath = $exePath
$sc.Description = 'CFPilot 异地组网节点'
$sc.Save()

Write-Host "安装完成：$installDir"
Write-Host '以后可从开始菜单「CFPilot Mesh」启动。'
Write-Host '组网配置请用 CFPilot 桌面面板「组网」页生成，命令行：'
Write-Host "  `"$exePath`" --mesh-config <配置.json>"
