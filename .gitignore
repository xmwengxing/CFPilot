# 本机部署诊断与临时产物
/tmp/
/packages/worker-core/.bisect*/
/packages/worker-core/.pages-*/
/packages/worker-core/.split-*/
/packages/worker-core/.merge-single/
/packages/worker-core/.dev-remote/
/packages/worker-core/dist-wr/

# GUI 打包产物（图标源文件在 packages/gui/build，需保留）
/packages/gui/release/
.workbuddy/

# Go 桌面版：构建产物与界面资源拷贝
#   dist/          三平台二进制
#   assets/        由 scripts/build-desktop.mjs 从 packages/gui/dist 拷来，
#                  属构建中间物，不入库（避免界面源码出现两份真相）。
#                  但目录本身必须保留一个文件 —— go:embed 匹配不到文件会编译失败，
#                  所以只忽略真实产物，保留说明文件。
/packages/desktop/dist/
/packages/desktop/internal/server/assets/index.html
/packages/desktop/internal/server/assets/renderer.js
/packages/desktop/cfpilot-*

# 开发过程文档（不入库，内容已整合进 README / 本地 HANDOVER.md）
/docs/*.md
/docs/*.ini
/docs/tist.ini
# 反代 IP 的**实测产物**不入库：它是特定网络、特定时刻的快照，
# 换个时间/网络重跑结果就不同，进了仓库只会制造无意义的 diff。
# 候选池本身（docs/relay-ip-candidates.csv）是工具输入，需要入库。
/docs/relay-ip-measured.csv
/docs/relay-ip-entry.json
/docs/relay-ip-round*.json
/docs/relay-ip-outbound.json
/docs/relay-ip-proxypool.txt
# 多源合并的中间产物（scripts/collect-relay-sources.mjs 生成，随时可重跑；
# 真正的产物是 packages/cli/assets/relay-ip-builtin.txt，那份才入库）
/docs/relay-ip-merged.csv
/docs/relay-ip-merged.txt
/docs/relay-ip-merged-r*.json
# 但 README 引用的截图必须入库
!/docs/images/
!/docs/images/**

# 本地开发规范与交接文档（不入库）
/HANDOVER.md
/RELEASE_NOTES.md
/AGENTS.md
/CLAUDE.md
/.cursorrules
release_body.md

# 发布说明按版本存放，默认不入库；
# 需要随 Release 发布时用 `git add -f .release-notes/<版本>.md` 单独带上
/.release-notes/
# go-winres 生成的 Windows 资源（构建时重新生成，不入库）
/packages/desktop/cmd/cfpilot/*.syso
.workbuddy-ai/
