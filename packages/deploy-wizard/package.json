{
  "name": "cfpilot-deploy",
  "version": "0.4.2",
  "description": "CFPilot 全中文部署向导：自动创建 KV、部署 Worker 内核、绑定自定义域名",
  "license": "MIT",
  "author": "CFPilot Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmwengxing/CFPilot.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "deploy",
    "wizard",
    "cfpilot"
  ],
  "type": "module",
  "bin": {
    "cfpilot-deploy": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/sync-asset.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/sync-version.mjs packages/deploy-wizard && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
