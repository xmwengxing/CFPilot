{
  "name": "cfpilot",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "CFPilot — Cloudflare Workers 代理微内核 + 真连接优选面板 + 本地优选器 + 中文部署向导",
  "license": "MIT",
  "author": "CFPilot Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/xmwengxing/CFPilot.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "vless",
    "trojan",
    "xhttp",
    "proxy",
    "subscription",
    "ip-optimization"
  ],
  "workspaces": [
    "packages/worker-core",
    "packages/scanner-cli",
    "packages/deploy-wizard",
    "packages/ui"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/make-pages-zip.mjs",
    "zip:pages": "node scripts/make-pages-zip.mjs",
    "check:geosite": "node scripts/check-geosite.mjs",
    "build:worker": "npm run build -w @cfpilot/worker-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @cfpilot/worker-core",
    "verify": "npm run build && npm run typecheck && npm run test && node scripts/check-geosite.mjs && node scripts/check-log-panel.mjs && node scripts/check-adapter-contract.mjs && node scripts/check-adapter-shape.mjs && node scripts/check-ui-integration.mjs && node scripts/check-build-version.mjs",
    "check:log-panel": "node scripts/check-log-panel.mjs",
    "check:adapter": "node scripts/check-adapter-contract.mjs",
    "check:adapter-shape": "node scripts/check-adapter-shape.mjs",
    "check:ui": "node scripts/check-ui-integration.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "clean": "node scripts/clean.mjs",
    "check:build-version": "node scripts/check-build-version.mjs",
    "publish:npm": "node scripts/publish-npm.mjs cfpilot-scanner && node scripts/publish-npm.mjs cfpilot-deploy",
    "verify:npm": "node scripts/verify-npm-publish.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "app-builder-bin": true,
    "7zip-bin": true
  }
}
