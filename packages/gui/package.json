{
  "name": "@cfpilot/gui",
  "version": "0.5.3",
  "private": true,
  "description": "CFPilot 图形化部署与维护工具 —— 一键部署 Pages 双项目、本地真连接优选、检查更新",
  "main": "dist/main/main.js",
  "license": "MIT",
  "author": "CFPilot Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmwengxing/CFPilot.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "app-builder-bin": true,
    "7zip-bin": true
  },
  "build": {
    "appId": "dev.cfpilot.gui",
    "productName": "CFPilot",
    "copyright": "Copyright © CFPilot Contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../worker-core/dist",
        "to": "worker-core/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/worker-core/dist/**",
      "**/dist/main/scanner-lib.js",
      "**/dist/main/deployer-lib.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CFPilot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CFPilot",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "allowElevation": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "CFPilot-${version}-portable.exe"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronVersion": "33.4.11",
    "electronDist": "../../node_modules/electron/dist",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "compression": "maximum"
  }
}
